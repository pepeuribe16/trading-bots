{
  "hosting": [
    {
      "site": "market-dashboard-gga",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/portfolio", "destination": "/portfolio/index.html" },
        { "source": "/portfolio-btc", "destination": "/portfolio-btc/index.html" },
        { "source": "/japan-fares", "destination": "/japan-fares/index.html" },
        { "source": "/historico", "destination": "/historico/index.html" },
        { "source": "**", "destination": "/index.html" }
      ]
    }
  ]
}
